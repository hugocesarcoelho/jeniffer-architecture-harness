{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_id",
    "client_name",
    "project_type",
    "rooms"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "client_name": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "enum": [
        "interiores",
        "arquitetura",
        "reforma",
        "arquitetura-e-interiores"
      ]
    },
    "address": {
      "type": "string"
    },
    "status": {
      "enum": [
        "intake",
        "analysis",
        "concept",
        "revision",
        "approved",
        "detailing",
        "completed"
      ]
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "room_id",
          "name",
          "floor"
        ],
        "properties": {
          "room_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "floor": {
            "type": [
              "string",
              "integer"
            ]
          },
          "views_requested": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}